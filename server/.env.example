# ShopKart Backend Environment Variables

# MongoDB connection string (Local or MongoDB Atlas)
dbURL=mongodb://localhost:27017/shopKart

# JWT secret key for signing authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Test Mode credentials (Optional for basic browsing, required for checkout/payment)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
